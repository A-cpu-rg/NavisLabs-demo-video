   "lines": [
    {
     "text": "The same company's agents use Navis Developer.",
     "start_s": 0.12,
     "end_s": 2.91,
     "pause_after": false
    },
    {
     "text": "Invite the team.",
     "start_s": 3.39,
     "end_s": 4.14,
     "pause_after": false
    },
    {
     "text": "Connect once \u2014 through MCP, API, SDK or CLI.",
     "start_s": 5.01,
     "end_s": 10.21,
     "pause_after": false
    },
    {
     "text": "The agent asks \u2014",
     "start_s": 11.07,
     "end_s": 12.0,
     "pause_after": false
    },
    {
     "text": "and gets the company's context, with sources and freshness.",
     "start_s": 12.42,
     "end_s": 16.43,
     "pause_after": false
    },
    {
     "text": "Navis isn't the model.",
     "start_s": 17.18,
     "end_s": 18.95,
     "pause_after": true
    },
    {
     "text": "It supplies the company's truth.",
     "start_s": 20.53,
     "end_s": 22.68,
     "pause_after": false
    },
    {
     "text": "Every request is checked against its permissions.",
     "start_s": 23.64,
     "end_s": 26.25,
     "pause_after": false
    },
    {
     "text": "The agent does the work,",
     "start_s": 26.84,
     "end_s": 27.89,
     "pause_after": false
    },
    {
     "text": "and the run is on record.",
     "start_s": 28.21,
     "end_s": 29.62,
     "pause_after": false
    }
   ]
  },
