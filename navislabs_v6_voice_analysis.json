   "lines": [
    {
     "text": "Inside a company, the Navis App is for people.",
     "start_s": 0.09,
     "end_s": 2.73,
     "pause_after": false
    },
    {
     "text": "It shows what changed \u2014",
     "start_s": 3.53,
     "end_s": 4.99,
     "pause_after": false
    },
    {
     "text": "and why it matters.",
     "start_s": 5.43,
     "end_s": 6.77,
     "pause_after": false
    },
    {
     "text": "Every fact has its source, its time, and how fresh it is.",
     "start_s": 7.52,
     "end_s": 11.23,
     "pause_after": false
    },
    {
     "text": "When something needs a decision, Navis prepares the next step.",
     "start_s": 12.02,
     "end_s": 15.48,
     "pause_after": true
    },
    {
     "text": "A person decides.",
     "start_s": 17.21,
     "end_s": 18.56,
     "pause_after": true
    },
    {
     "text": "Then the company acts.",
     "start_s": 20.29,
     "end_s": 22.19,
     "pause_after": false
    }
   ]
